    "settings.precision_warning": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher precision uses more CPU. For always-on screensaver, use Minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "精度が高いほど CPU 使用量が増えます。常時表示は「分」推奨。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "精度越高 CPU 佔用越高，屏保常駐建議使用「分」。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精度越高 CPU 占用越高，屏保常驻建议使用「分」。"
